#!/usr/bin/env python3
"""``forensics-modules`` — CLI for the modular forensic-tool installer.

This is a thin wrapper around :class:`forensics.modules.ModuleManager`. The
real work lives in the Python package; keeping this file slim makes both
unit testing and behaviour changes cheap.
"""
from __future__ import annotations

import argparse
import sys
import textwrap
from pathlib import Path

# Make the in-tree package importable when this script is invoked directly
# (eg by /usr/local/bin/forensics-modules → core/module-manager/forensics-modules).
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str((HERE.parent.parent).resolve()))

from forensics import __version__  # noqa: E402
from forensics.colors import BOLD, CYAN, DIM, GREEN, NC, RED, YELLOW  # noqa: E402
from forensics.modules.manager import ModuleManager  # noqa: E402
from forensics.modules.registry import ModuleSpec  # noqa: E402


# ── command implementations ────────────────────────────────────────────────

def cmd_list(args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    modules = mgr.list_modules(category=args.category)

    if args.json:
        import json
        payload = []
        for m in modules:
            payload.append({
                "name": m.name,
                "category": m.category,
                "version": m.stable_version,
                "size_mb": m.estimated_size_mb,
                "tools":   m.tool_count,
                "experimental": m.experimental,
                "installed": mgr.is_marked_installed(m.name),
                "submodules": [s.name for s in m.submodules],
            })
        print(json.dumps(payload, indent=2))
        return 0

    print(f"\n{CYAN}{'═' * 78}{NC}")
    print(f"{BOLD}  Forensics Modules — registry v{__version__}{NC}")
    print(f"{CYAN}{'═' * 78}{NC}")
    print(f"  {'NAME':<22} {'CAT':<10} {'TOOLS':>5} {'SIZE':>8}  {'STATE':<14} FLAGS")
    print(f"  {'-' * 22} {'-' * 10} {'-' * 5} {'-' * 8}  {'-' * 14} {'-' * 5}")
    for m in modules:
        installed = mgr.is_marked_installed(m.name)
        state = (f"{GREEN}installed{NC}" if installed
                 else f"{YELLOW}available{NC}")
        flags = "experimental" if m.experimental else ""
        print(f"  {m.name:<22} {m.category:<10} {m.tool_count:>5} "
              f"{m.estimated_size_mb:>5} MB  {state:<23} {flags}")
    print()
    return 0


def cmd_info(args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    spec = mgr.get(args.module)
    if spec is None:
        print(f"{RED}unknown module: {args.module}{NC}", file=sys.stderr)
        return 2

    print(f"\n{CYAN}{'═' * 64}{NC}")
    print(f"{BOLD}  {spec.name}{NC}  ({spec.category})")
    print(f"{CYAN}{'═' * 64}{NC}")
    print(f"  Version       : {spec.stable_version}")
    print(f"  Size estimate : {spec.estimated_size_mb} MB")
    print(f"  Tool count    : {spec.tool_count}")
    print(f"  Experimental  : {'yes' if spec.experimental else 'no'}")
    print(f"  Description   : {spec.description}")
    if spec.dependencies:
        print(f"  Dependencies  : {', '.join(spec.dependencies)}")
    print(f"\n  {BOLD}Submodules{NC}")
    for sm in spec.submodules:
        verify_str = ", ".join(sm.verify) if sm.verify else f"{DIM}(unverified){NC}"
        notes = f"  — {sm.notes}" if sm.notes else ""
        print(f"    • {sm.name:<22} verify: {verify_str}{notes}")
    if spec.known_issues:
        print(f"\n  {YELLOW}Known issues{NC}")
        for sub, issue in spec.known_issues.items():
            print(f"    {sub}: {issue}")
    if spec.tools_overview:
        print(f"\n  Tools: {', '.join(spec.tools_overview)}")
    print()
    return 0


def cmd_install(args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    if args.module not in mgr.registry:
        print(f"{RED}unknown module: {args.module}{NC}", file=sys.stderr)
        return 2

    only = [s.strip() for s in args.only.split(",")] if args.only else None
    skip = [s.strip() for s in args.skip.split(",")] if args.skip else None

    if not args.yes and not args.dry_run:
        spec = mgr.registry[args.module]
        print(f"\nAbout to install {BOLD}{spec.name}{NC} "
              f"v{spec.stable_version} ({spec.estimated_size_mb} MB).")
        if input("Proceed? [Y/n] ").strip().lower() in ("n", "no"):
            print("aborted.")
            return 1

    try:
        result = mgr.install(
            args.module,
            only=only, skip=skip,
            jobs=args.jobs,
            dry_run=args.dry_run,
            force=args.force,
        )
    except KeyError as exc:
        print(f"{RED}{exc}{NC}", file=sys.stderr)
        return 2

    return 0 if result.overall in ("success", "noop") else (
        1 if result.overall == "partial" else 3
    )


def cmd_remove(args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    if args.module not in mgr.registry:
        print(f"{RED}unknown module: {args.module}{NC}", file=sys.stderr)
        return 2
    if not args.yes and not args.dry_run:
        if input(f"remove {args.module}? [y/N] ").strip().lower() not in ("y", "yes"):
            print("aborted.")
            return 1
    result = mgr.remove(args.module, dry_run=args.dry_run)
    return 0 if result.overall in ("success", "noop") else 1


def cmd_status(_args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    print(f"\n{CYAN}{'═' * 64}{NC}")
    print(f"{BOLD}  Installed modules{NC}")
    print(f"{CYAN}{'═' * 64}{NC}")
    installed = mgr.installed_modules()
    if not installed:
        print(f"  {DIM}(none yet — try: forensics-modules install <name>){NC}\n")
        return 0
    for name in installed:
        manifest = mgr.load_manifest(name) or {}
        ts = manifest.get("installed_at", "?")
        ver = manifest.get("version", "?")
        digest = manifest.get("digest", "")[:16]
        print(f"  {GREEN}✓{NC}  {name:<22} v{ver:<10} {ts:<28} {DIM}{digest}{NC}")
    print()
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    name = args.module if args.module != "all" else None
    results = mgr.verify(name=name)
    if not results:
        print(f"{YELLOW}nothing installed to verify{NC}")
        return 0

    overall_ok = True
    for mod_name, sub_results in results.items():
        print(f"\n  {BOLD}{mod_name}{NC}")
        for sm_name, check in sub_results.items():
            symbol = f"{GREEN}✓{NC}" if check.ok else f"{RED}✗{NC}"
            if not check.ok:
                overall_ok = False
            missing = ", ".join(h for h, ok in check.findings if not ok)
            detail = "" if check.ok else f"missing: {missing}"
            print(f"    {symbol}  {sm_name:<22} {DIM}{detail}{NC}")
    print()
    return 0 if overall_ok else 1


def cmd_repair(args: argparse.Namespace) -> int:
    mgr = ModuleManager()
    result = mgr.repair(args.module)
    return 0 if result.overall in ("success", "noop") else 1


# ── Argparse plumbing ──────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="forensics-modules",
        description="Modular forensic-tool installer with audited operations.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Examples:
              forensics-modules list
              forensics-modules info memory-forensics
              forensics-modules install memory-forensics --only volatility,avml
              forensics-modules install osint-tools --dry-run
              forensics-modules verify all
              forensics-modules repair malware-analysis
        """),
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    # list
    s = sub.add_parser("list", help="List available modules.")
    s.add_argument("--category", help="Filter by category.")
    s.add_argument("--json", action="store_true", help="Emit JSON for tooling.")
    s.set_defaults(fn=cmd_list)

    # info
    s = sub.add_parser("info", help="Show module details.")
    s.add_argument("module")
    s.set_defaults(fn=cmd_info)

    # install
    s = sub.add_parser("install", help="Install a module.")
    s.add_argument("module")
    s.add_argument("--only", help="Comma-separated submodules to include.")
    s.add_argument("--skip", help="Comma-separated submodules to exclude.")
    s.add_argument("--jobs", type=int, help="Parallel installer jobs (advanced).")
    s.add_argument("--force", action="store_true",
                   help="Reinstall even if verifier hints already pass.")
    s.add_argument("--dry-run", action="store_true",
                   help="Print the plan; run nothing.")
    s.add_argument("-y", "--yes", action="store_true",
                   help="Don't prompt for confirmation.")
    s.set_defaults(fn=cmd_install)

    # remove
    s = sub.add_parser("remove", help="Uninstall a module.")
    s.add_argument("module")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("-y", "--yes", action="store_true")
    s.set_defaults(fn=cmd_remove)

    # status
    s = sub.add_parser("status", help="Show installed modules.")
    s.set_defaults(fn=cmd_status)

    # verify
    s = sub.add_parser("verify", help="Verify installed modules against registry hints.")
    s.add_argument("module", nargs="?", default="all")
    s.set_defaults(fn=cmd_verify)

    # repair
    s = sub.add_parser("repair", help="Reinstall submodules whose verifier currently fails.")
    s.add_argument("module")
    s.set_defaults(fn=cmd_repair)

    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.fn(args) or 0)


if __name__ == "__main__":
    raise SystemExit(main())
