#!/usr/bin/env python3
"""``forensics-audit`` — CLI for the audit log.

Subcommands:
    verify    cryptographic integrity verification (hash chain + signatures)
    show      print recent entries (filterable)
    export    export the log (JSON Lines or CSV)
    stats     summary counters
"""
from __future__ import annotations

import argparse
import csv
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str((HERE.parent.parent).resolve()))

from forensics import __version__  # noqa: E402
from forensics.audit.logger import get_logger  # noqa: E402
from forensics.colors import BOLD, CYAN, DIM, GREEN, NC, RED, YELLOW  # noqa: E402


def cmd_verify(_args: argparse.Namespace) -> int:
    log = get_logger()
    result = log.verify()

    print(f"\n{CYAN}{'═' * 64}{NC}")
    print(f"{BOLD}  Audit Trail Integrity Verification{NC}")
    print(f"{CYAN}{'═' * 64}{NC}")

    print(f"  Total entries        : {result.get('total_entries', 0)}")
    print(f"  Broken links         : {len(result.get('broken_links', []))}")
    print(f"  Sequence gaps        : {len(result.get('sequence_gaps', []))}")
    print(f"  Signature failures   : {len(result.get('signature_failures', []))}")

    status = result.get("status", "UNKNOWN")
    if status == "VALID":
        print(f"\n  {GREEN}{BOLD}STATUS: VALID{NC}")
        print(f"  {GREEN}Hash chain intact, signatures verified.{NC}\n")
        return 0
    if status == "EMPTY":
        print(f"\n  {YELLOW}STATUS: EMPTY (no entries yet){NC}\n")
        return 0
    if status == "ERROR":
        print(f"\n  {RED}STATUS: ERROR — {result.get('error', '?')}{NC}\n")
        return 2

    print(f"\n  {RED}{BOLD}STATUS: COMPROMISED{NC}\n")
    for item in (result.get("broken_links") or [])[:10]:
        print(f"    {RED}↳{NC} seq {item.get('seq')}: {item.get('reason')}")
    for item in (result.get("sequence_gaps") or [])[:10]:
        print(f"    {RED}↳{NC} gap: expected {item.get('expected')}, "
              f"got {item.get('got')}")
    for item in (result.get("signature_failures") or [])[:10]:
        print(f"    {RED}↳{NC} signature seq {item.get('seq')}: "
              f"{item.get('reason')}")
    print()
    return 1


def cmd_show(args: argparse.Namespace) -> int:
    log = get_logger()
    entries = log.show_entries(
        limit=args.limit,
        event_type=args.event_type,
        user=args.user,
    )
    if not entries:
        print(f"{YELLOW}no entries match the filter{NC}")
        return 0

    if args.json:
        print(json.dumps(entries, indent=2, ensure_ascii=False))
        return 0

    print(f"\n  {'SEQ':<6} {'TIMESTAMP':<28} {'EVENT':<32} {'USER':<14} HASH")
    print(f"  {'-' * 6} {'-' * 28} {'-' * 32} {'-' * 14} {'-' * 16}")
    for e in entries:
        seq = str(e.get("seq", "?"))
        ts = (e.get("timestamp") or "?")[:26]
        ev = (e.get("event_type") or "?")[:32]
        usr = (e.get("user") or "?")[:14]
        h = (e.get("hash") or "")[:16]
        colour = GREEN
        ev_lc = ev.lower()
        if "fail" in ev_lc or "error" in ev_lc:
            colour = RED
        elif "install" in ev_lc:
            colour = CYAN
        print(f"  {seq:<6} {ts:<28} {colour}{ev:<32}{NC} {usr:<14} "
              f"{DIM}{h}{NC}")
    print(f"\n  {DIM}{len(entries)} entries{NC}\n")
    return 0


def cmd_export(args: argparse.Namespace) -> int:
    log = get_logger()
    out = Path(args.output)
    if args.format == "jsonl":
        n = log.export_jsonl(out)
        size = out.stat().st_size
        print(f"  {GREEN}✓{NC} {n} entries exported → {out} ({size:,} bytes)")
        return 0

    # CSV
    entries = log.show_entries(limit=10**9)
    fields = ["seq", "timestamp", "event_type", "user", "container_id",
              "prev_hash", "hash", "details"]
    with out.open("w", encoding="utf-8", newline="") as fh:
        writer = csv.DictWriter(fh, fieldnames=fields)
        writer.writeheader()
        for e in entries:
            row = {k: e.get(k, "") for k in fields}
            row["details"] = json.dumps(row["details"], ensure_ascii=False)
            writer.writerow(row)
    print(f"  {GREEN}✓{NC} {len(entries)} entries exported → {out}")
    return 0


def cmd_stats(_args: argparse.Namespace) -> int:
    log = get_logger()
    stats = log.stats()
    print(f"\n{CYAN}{'═' * 64}{NC}")
    print(f"{BOLD}  Audit Log Statistics{NC}")
    print(f"{CYAN}{'═' * 64}{NC}")
    print(f"  Total entries : {stats.get('total_entries', 0)}")
    print(f"  Log size      : {stats.get('log_size_bytes', 0):,} bytes")
    print(f"  First entry   : {stats.get('first_entry') or 'n/a'}")
    print(f"  Last entry    : {stats.get('last_entry') or 'n/a'}")
    print(f"\n  {BOLD}Event counts{NC}")
    counts = stats.get("event_counts") or {}
    if not counts:
        print(f"    {DIM}(none){NC}")
    for evt, count in sorted(counts.items(), key=lambda x: -x[1]):
        colour = RED if "fail" in evt or "violation" in evt else (
            CYAN if "install" in evt else NC)
        print(f"    {colour}{evt:<36}{NC} {count:>6}")
    print()
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="forensics-audit",
        description="Cryptographic audit-log inspector & verifier.",
    )
    p.add_argument("--version", action="version",
                   version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("verify", help="Verify integrity (hash chain + signatures).") \
        .set_defaults(fn=cmd_verify)

    s = sub.add_parser("show", help="Show recent entries.")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--event-type")
    s.add_argument("--user")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("export", help="Export the log.")
    s.add_argument("--output", required=True)
    s.add_argument("--format", choices=["jsonl", "csv"], default="jsonl")
    s.set_defaults(fn=cmd_export)

    sub.add_parser("stats", help="Aggregate counters.") \
        .set_defaults(fn=cmd_stats)

    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.fn(args) or 0)


if __name__ == "__main__":
    raise SystemExit(main())
