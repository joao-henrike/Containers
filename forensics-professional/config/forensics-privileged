#!/usr/bin/python3
"""Root-owned, argument-validating privilege helper for the forensics container.

Only a fixed set of package names from the image's configured APT repositories
may be installed or removed. This program never invokes a shell, never accepts
APT options or local package paths, and never edits APT source/key configuration.
"""
from __future__ import annotations

import fcntl
import os
import pwd
import re
import stat
import struct
import subprocess
import sys

APT_GET = "/usr/bin/apt-get"
AUDIT_LOG = "/var/log/forensics/audit.log"
FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_APPEND_FL = 0x00000020

# Keep this list synchronized with apt_install() and REMOVERS in installers.py.
# These are the only APT package names the analyst can install/remove at runtime.
ALLOWED_PACKAGES = frozenset({
    "amass",
    "android-tools-adb",
    "android-tools-fastboot",
    "auditd",
    "audispd-plugins",
    "build-essential",
    "clamav",
    "curl",
    "dcfldd",
    "default-jdk",
    "default-jre-headless",
    "dnsenum",
    "dnsrecon",
    "e2fsprogs",
    "extundelete",
    "foremost",
    "gddrescue",
    "git",
    "goaccess",
    "ifuse",
    "ideviceinstaller",
    "libimobiledevice-utils",
    "libparse-win32registry-perl",
    "libpst4",
    "logwatch",
    "mysql-client",
    "ngrep",
    "postgresql-client",
    "pst-utils",
    "scalpel",
    "sqlite3",
    "sleuthkit",
    "tcpdump",
    "tcpflow",
    "testdisk",
    "tshark",
    "unzip",
    "wireshark-common",
    "yara",
    "zeek",
})

# Only packages with an explicit uninstaller in installers.py can be removed.
ALLOWED_REMOVE_PACKAGES = frozenset({
    "android-tools-adb",
    "android-tools-fastboot",
    "auditd",
    "audispd-plugins",
    "clamav",
    "e2fsprogs",
    "extundelete",
    "foremost",
    "libpst4",
    "logwatch",
    "mysql-client",
    "ngrep",
    "postgresql-client",
    "pst-utils",
    "scalpel",
    "sleuthkit",
    "tcpdump",
    "tcpflow",
    "testdisk",
    "tshark",
    "wireshark-common",
    "yara",
    "goaccess",
})

SAFE_ENV = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME": "/root",
    "DEBIAN_FRONTEND": "noninteractive",
    "LC_ALL": "C.UTF-8",
}


def fail(message: str, code: int = 2) -> int:
    print(f"forensics-privileged: {message}", file=sys.stderr)
    return code


def run(argv: list[str]) -> int:
    if os.geteuid() != 0:
        return fail("must be invoked by sudo as root", 1)
    if not argv:
        return fail("missing operation")

    operation, *args = argv
    if operation == "apt-update":
        if args:
            return fail("apt-update takes no arguments")
        return subprocess.run([APT_GET, "update"], env=SAFE_ENV, check=False).returncode

    if operation in {"apt-install", "apt-remove"}:
        if not args:
            return fail(f"{operation} requires one or more package names")
        for package in args:
            if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]*", package):
                return fail(f"invalid package token: {package!r}")
            allowlist = ALLOWED_PACKAGES if operation == "apt-install" else ALLOWED_REMOVE_PACKAGES
            if package not in allowlist:
                return fail(f"package is not allowlisted for {operation}: {package}")
        if operation == "apt-install":
            command = [APT_GET, "install", "-y", "--no-install-recommends", *args]
        else:
            command = [APT_GET, "remove", "-y", *args]
        return subprocess.run(command, env=SAFE_ENV, check=False).returncode

    if operation == "audit-append-only":
        if args:
            return fail("audit-append-only takes no arguments")
        # Do not pass a user-writable pathname to a root chattr process: open
        # the fixed path without following symlinks, then mutate only that fd.
        try:
            fd = os.open(AUDIT_LOG, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError as exc:
            return fail(f"cannot safely open audit log: {exc}", 1)
        try:
            info = os.fstat(fd)
            expected_uid = pwd.getpwnam("sherlock").pw_uid
            if not stat.S_ISREG(info.st_mode) or info.st_uid != expected_uid:
                return fail("audit log must be a regular file owned by sherlock", 1)
            current = struct.unpack("I", fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("I", 0)))[0]
            if current & FS_APPEND_FL:
                return 0
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("I", current | FS_APPEND_FL))
            return 0
        except OSError as exc:
            return fail(f"cannot set append-only flag: {exc}", 1)
        finally:
            os.close(fd)

    return fail(f"unsupported operation: {operation!r}")


if __name__ == "__main__":
    raise SystemExit(run(sys.argv[1:]))
