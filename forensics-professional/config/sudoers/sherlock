# Sherlock — minimal privilege boundary
#
# No direct APT, pip, file-placement, repository-management, chmod/chown,
# chattr, or shell permissions are granted here. The only NOPASSWD entry is a
# root-owned helper whose operations and package names are statically validated.
Defaults:sherlock env_reset
Defaults:sherlock !setenv
Defaults:sherlock secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

sherlock ALL=(root) NOPASSWD: /usr/local/sbin/forensics-privileged *

