# ==============================================================================
# Forensics Professional — .gitignore
# ==============================================================================

# ── Forensic data — NEVER commit ────────────────────────────────────────────
evidence/*
!evidence/.gitkeep
cases/*
!cases/.gitkeep
reports/*
!reports/.gitkeep
keys/*
!keys/.gitkeep
logs/*
!logs/.gitkeep
modules/installed/*
!modules/installed/.gitkeep

# Forensic image / capture extensions
*.dd
*.img
*.raw
*.E01
*.Ex01
*.L01
*.Lx01
*.AFF
*.vmdk
*.vdi
*.vhd
*.mem
*.dmp
*.pcap
*.pcapng

# ── Cryptographic material ──────────────────────────────────────────────────
*.key
*.pem
*.gpg
*.asc
*.p12
*.pfx
*_rsa
*_ed25519

# ── Local / per-deployment overrides ────────────────────────────────────────
docker-compose.override.yml
.env
.env.local
.env.*.local
config/local.yaml
config/local.json

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.venv/
venv/
env/
.Python
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ── Editors / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Build artefacts ─────────────────────────────────────────────────────────
*.o
*.a
*.so
*.exe
*.out

# ── CI ──────────────────────────────────────────────────────────────────────
.cache/
trivy-results.*

# Keep .gitkeep markers
!**/.gitkeep
