#!/usr/bin/env python3
"""``forensics-health`` — runtime health check used both interactively and
by Docker's HEALTHCHECK."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str((HERE.parent / "core").resolve()))

from forensics import __version__  # noqa: E402
from forensics.health.monitor import quick_check, run_check  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="forensics-health",
        description="Health checks for the Forensics Professional container.",
    )
    p.add_argument("--version", action="version",
                   version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=False)

    s = sub.add_parser("check", help="Full health check (default).")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=lambda a: run_check(output_json=a.json))

    s = sub.add_parser("quick-check",
                       help="Lightweight liveness check (Docker HEALTHCHECK).")
    s.add_argument("--silent", action="store_true",
                   help="No output; exit code only.")
    s.set_defaults(fn=lambda a: quick_check(silent=a.silent))

    args = p.parse_args(argv)
    if args.cmd is None:
        return run_check(output_json=False)
    return int(args.fn(args) or 0)


if __name__ == "__main__":
    raise SystemExit(main())
